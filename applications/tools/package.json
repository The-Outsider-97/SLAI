{
  "name": "slai-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Python server layer and web interface kit for SLAI applications",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test tests_ts/*.test.ts",
    "test:compiled": "tsc -p tsconfig.test.json && node --test .test-out/tests_ts/*.test.js",
    "test:py": "python3 -m unittest discover -s tests -t ../.. -v"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
