{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slai.local/schemas/sgeo.json",
  "type": "object",
  "required": [
    "document_id",
    "revision",
    "name",
    "objects",
    "families",
    "metadata",
    "materials",
    "images"
  ],
  "additionalProperties": false,
  "properties": {
    "document_id": {
      "$ref": "spatial_core.json#/$defs/uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "maxLength": 255
    },
    "metadata": {
      "$ref": "spatial_core.json#/$defs/metadata"
    },
    "families": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object"
      }
    },
    "objects": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "$ref": "spatial_core.json#/$defs/uuid"
          },
          "parent": {
            "anyOf": [
              {
                "$ref": "spatial_core.json#/$defs/uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "transform": {
            "$ref": "spatial_core.json#/$defs/matrix4"
          },
          "geometry": {
            "type": [
              "object",
              "null"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "metadata": {
            "$ref": "spatial_core.json#/$defs/metadata"
          },
          "family_id": {
            "$ref": "spatial_core.json#/$defs/uuid"
          },
          "parameters": {
            "type": "object"
          },
          "material": {
            "$ref": "spatial_core.json#/$defs/uuid"
          }
        },
        "additionalProperties": false
      }
    },
    "materials": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object"
      }
    },
    "images": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object"
      }
    }
  }
}
