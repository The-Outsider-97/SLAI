{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slai.local/schemas/sdrw.json",
  "type": "object",
  "required": [
    "document_id",
    "revision",
    "name",
    "layers",
    "entities",
    "metadata",
    "linetypes",
    "blocks"
  ],
  "additionalProperties": false,
  "properties": {
    "document_id": {
      "$ref": "spatial_core.json#/$defs/uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "maxLength": 255
    },
    "metadata": {
      "$ref": "spatial_core.json#/$defs/metadata"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "visible": {
            "type": "boolean"
          },
          "stroke": {
            "type": "string",
            "maxLength": 32
          },
          "stroke_width": {
            "type": "number",
            "minimum": 0
          },
          "linetype": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "additionalProperties": false
      }
    },
    "entities": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "linetypes": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "name",
          "pattern"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "maxLength": 255
          },
          "pattern": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "number"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "blocks": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "name",
          "base_point",
          "entities"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "maxLength": 255
          },
          "base_point": {
            "$ref": "spatial_core.json#/$defs/vec2"
          },
          "entities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100000,
            "items": {
              "$ref": "#/$defs/entity"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "geometry"
      ],
      "properties": {
        "id": {
          "$ref": "spatial_core.json#/$defs/uuid"
        },
        "kind": {
          "enum": [
            "point",
            "line",
            "polyline",
            "circle",
            "arc",
            "text",
            "dimension",
            "hatch",
            "insert"
          ]
        },
        "layer": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "geometry": {
          "type": "object"
        },
        "metadata": {
          "$ref": "spatial_core.json#/$defs/metadata"
        },
        "style": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "stroke",
              "stroke_width",
              "fill",
              "linetype",
              "linetype_scale"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
